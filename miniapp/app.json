{
  "pages": [
    "pages/index/index",
    "pages/watchlist/watchlist",
    "pages/profile/profile"
  ],
  "subpackages": [
    {
      "root": "package-detail",
      "name": "detail",
      "pages": [
        "pages/stock-detail/stock-detail",
        "pages/etf-detail/etf-detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["detail"]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "ETF资金流",
    "backgroundColor": "#f5f6f7",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#7a7e83",
    "selectedColor": "#d43c33",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "榜单",
        "iconPath": "assets/tab-rank.png",
        "selectedIconPath": "assets/tab-rank-on.png"
      },
      {
        "pagePath": "pages/watchlist/watchlist",
        "text": "自选",
        "iconPath": "assets/tab-star.png",
        "selectedIconPath": "assets/tab-star-on.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "assets/tab-me.png",
        "selectedIconPath": "assets/tab-me-on.png"
      }
    ]
  },
  "usingComponents": {
    "disclosure-bar": "/components/disclosure-bar/disclosure-bar",
    "rank-item": "/components/rank-item/rank-item",
    "stock-row": "/components/stock-row/stock-row",
    "empty-state": "/components/empty-state/empty-state",
    "load-more": "/components/load-more/load-more"
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
