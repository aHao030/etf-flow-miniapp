.stock-summary-head, .stock-search, .stock-between, .stock-units, .stock-pager, .stock-dates { display:flex; align-items:center; justify-content:space-between; gap:var(--spacing-1); }
.stock-input { flex:1; min-width:0; }
.stock-page .stock-back, .stock-page .stock-text-button, .stock-page .stock-outline, .stock-page .stock-source, .stock-page .stock-result, .stock-pager button { font-size:var(--font-size-sm); color:var(--color-text-primary); background:var(--color-background-surface); }
.stock-back, .stock-text-button { padding:var(--spacing-1) 0; text-align:left; }
.stock-page .stock-outline, .stock-pager button { border:1rpx solid var(--color-border-emphasized); }
.stock-summary-head { margin-top:var(--spacing-2); }
.stock-net { margin-top:var(--spacing-1); }
.stock-end { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:var(--spacing-1); border-top:1rpx solid var(--color-border); padding-top:var(--spacing-2); font-weight:600; }
.stock-result, .stock-source { width:100%; border-radius:0; text-align:left; }
.stock-result { display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid var(--color-border); }
.stock-page .stock-result, .stock-page .stock-source { padding:var(--spacing-2) 0; font-size:var(--font-size-base); }
.stock-source { display:block; border-top:1rpx solid var(--color-border); }
.stock-between text:first-child { flex:1; min-width:0; overflow-wrap:anywhere; }
.stock-source .stock-between text:last-child { max-width:55%; overflow-wrap:anywhere; text-align:right; }
.stock-track { height:var(--spacing-1); width:100%; margin:var(--spacing-1) 0; background:var(--color-background-muted); border-radius:var(--radius-full); overflow:hidden; }
.stock-bar { height:100%; background:var(--color-text-secondary); }
.stock-bar.pos { background:var(--market-inflow); }
.stock-bar.neg { background:var(--market-outflow); }
.stock-columns, .stock-pager { color:var(--color-text-secondary); font-size:var(--font-size-sm); }
.stock-grid { display:grid; grid-template-columns:1fr 1.3fr 1fr; gap:var(--spacing-1); align-items:center; padding:var(--spacing-1-5) 0; border-bottom:1rpx solid var(--color-border); font-size:var(--font-size-sm); }
.stock-grid text:not(:first-child) { text-align:right; overflow-wrap:anywhere; }
.stock-message { padding:var(--spacing-2); border-radius:var(--radius-element); background:var(--color-background-muted); }
.stock-dates picker { flex:1; min-width:0; }
.stock-date { display:flex; flex-direction:column; border:1rpx solid var(--color-border-emphasized); border-radius:var(--radius-element); padding:var(--spacing-1) var(--spacing-2); }
