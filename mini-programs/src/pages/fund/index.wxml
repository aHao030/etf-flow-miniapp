<view class="page fund-page">
  <view class="fund-head">
    <view class="fund-name"><text class="title">{{name}}</text><text class="fund-code">{{code}}</text></view>
    <view class="row"><button wx:if="{{ready}}" class="button" bindtap="retry">刷新</button><button class="button fund-back" bindtap="goBack">返回</button></view>
  </view>
  <source-note target="{{maxDate}}" />
  <view class="fund-filter" wx:if="{{minDate}}">
    
    <view class="fund-dates">
      <picker mode="date" start="{{minDate}}" end="{{maxDate}}" value="{{draftStart}}" data-field="draftStart" bindchange="changeDate">
        <view class="fund-date"><text class="muted">开始日期</text><text>{{draftStart}}</text></view>
      </picker>
      <picker mode="date" start="{{minDate}}" end="{{maxDate}}" value="{{draftEnd}}" data-field="draftEnd" bindchange="changeDate">
        <view class="fund-date"><text class="muted">结束日期</text><text>{{draftEnd}}</text></view>
      </picker>
      <button class="button active" bindtap="applyDates">应用</button>
    </view>
    <text wx:if="{{rangeNote}}" class="fund-note muted">{{rangeNote}}</text>
    <text wx:if="{{datePending}}" class="fund-note">日期待应用。</text>
  </view>

  <view wx:if="{{loading}}" class="panel"><text class="muted">正在读取基金历史…</text></view>
  <view wx:if="{{error}}" class="panel fund-state">
    <text>{{error}}</text>
    <button wx:if="{{retryable}}" class="button" bindtap="retry">{{needsNewVersion ? '使用新版重新查询' : '重新读取'}}</button>
  </view>

  <view wx:if="{{ready}}" class="panel">
    <text class="section-title">基金历史趋势</text>
    <text class="fund-note muted">{{start}} 至 {{end}}</text>
    <view wx:if="{{summaryValue}}" class="fund-summary">
      <text class="metric-label">{{summaryLabel}}</text><text class="amount {{summaryTone}}">{{summaryValue}}</text>
    </view>
    <view class="chips fund-metrics">
      <button class="chip {{metric === 'flow' ? 'active' : ''}}" data-metric="flow" bindtap="selectMetric">估算净申赎</button>
      <button class="chip {{metric === 'shares' ? 'active' : ''}}" data-metric="shares" bindtap="selectMetric">基金份额</button>
      <button class="chip {{metric === 'nav' ? 'active' : ''}}" data-metric="nav" bindtap="selectMetric">单位净值</button>
    </view>
    <text wx:if="{{coverage}}" class="fund-note muted">{{coverage}}</text>
    <flow-chart wx:if="{{chart}}" model="{{chart}}" />
    <text wx:if="{{chartNotice}}" class="fund-note">{{chartNotice}}</text>
    <button wx:if="{{chartRetry}}" class="button" bindtap="retry">{{chartRetry}}</button>
    <text wx:if="{{metric === 'flow'}}" class="fund-note muted">按份额变化 × 前一交易日净值估算，仅累计有值日。缺失日保留空白。</text>
  </view>

  <view wx:if="{{ready}}" class="panel">
    <view class="fund-detail-head">
      <view><text class="section-title">逐日原始记录</text><text class="fund-note muted">{{total}} 个观测日期</text></view>
      <button class="button" bindtap="toggleDetails">{{detailsOpen ? '收起' : '查看明细'}}</button>
    </view>
    <view wx:if="{{detailsOpen}}">
      <text wx:if="{{!total}}" class="fund-note muted">所选日期暂无份额或净值记录。</text>
      <text wx:if="{{detailLoading}}" class="fund-note muted">正在读取第 {{detailPage}} 页…</text>
      <view wx:if="{{detailError}}" class="fund-state">
        <text>{{detailError}}</text><button class="button" bindtap="retryDetails">重读本页</button>
      </view>
      <view class="fund-record" wx:for="{{detailRows}}" wx:key="date">
        <view class="fund-detail-head"><text class="fund-record-date">{{item.date}}</text><text class="muted">{{item.quality}}</text></view>
        <view class="fund-key-value"><text class="muted">估算净申赎</text><text class="{{item.tone}}">{{item.flow}}</text></view>
        <view class="fund-key-value"><text class="muted">份额（份）</text><text>{{item.shares}}</text></view>
        <view class="fund-key-value"><text class="muted">单位净值（元）</text><text>{{item.nav}}</text></view>
        <view class="fund-key-value"><text class="muted">累计净值（元）</text><text>{{item.accNav}}</text></view>
      </view>
      <view wx:if="{{total}}" class="fund-pager">
        <button class="button" disabled="{{detailLoading || detailPage === 1}}" data-step="-1" bindtap="turnPage">上一页</button>
        <text class="muted">{{detailPage}} / {{pageCount}}</text>
        <button class="button" disabled="{{detailLoading || detailPage >= pageCount}}" data-step="1" bindtap="turnPage">下一页</button>
      </view>
    </view>
  </view>
</view>
